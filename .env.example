NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Use 1 in producao para exigir cookies Secure.
COOKIE_SECURE=0

# Defina uma chave forte antes do primeiro acesso em producao.
# O primeiro usuario criado sera owner e podera cadastrar outros acessos depois.
ADMIN_SETUP_TOKEN=senha_forte
#troque-por-uma-chave-forte

# Em producao, aponte para um diretorio persistente do host, por exemplo /app/storage.
CMS_STORAGE_DIR=
